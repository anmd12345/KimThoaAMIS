@using ManagementKimThoa.Constants
@using ManagementKimThoa.DTOs.Employee
@model List<EmployeeListItemDto>
@{
    ViewData["Title"] = "Danh sách nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<nav class="mb-3" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="#!">Bảng điều khiển</a></li>
        <li class="breadcrumb-item active">Nhân sự</li>
        <li class="breadcrumb-item active">Danh sách nhân sự</li>
    </ol>
</nav>
<div class="pb-6">
    <h2 class="mb-4">Danh sách nhân sự</h2>
    <div id="lealsTable" data-list='{"valueNames":["name","email","phone","contact","company","date"],"page":10,"pagination":true}'>
        <div class="row g-3 justify-content-between mb-4">
            <div class="col-auto">
                <div class="d-flex">
                    <div class="search-box me-2">
                        <form class="position-relative">
                            <input class="form-control search-input search" type="search" placeholder="Search by name" aria-label="Search" />
                            <span class="fas fa-search search-box-icon"></span>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <div class="d-md-flex justify-content-between">
                    <div>
                        <a href="@RouteConstant.CreateEmployee" class="btn btn-primary me-4"><span class="fas fa-plus me-2"></span>Thêm nhân sự</a>
                        <button class="btn btn-link text-body px-0"><span class="fa-solid fa-file-export fs-9 me-2"></span>Export Excel</button>
                    </div>
                </div>
            </div>

        </div>
        <div class="table-responsive scrollbar mx-n1 px-1">
            <table class="table fs-9 mb-0 leads-table border-top border-translucent">

                <thead>
                    <tr>
                        <th style="width:18px;">
                            <div class="form-check mb-0 fs-8">
                                <input class="form-check-input"
                                       type="checkbox"
                                       data-bulk-select='{"body":"leal-tables-body"}' />
                            </div>
                        </th>

                        <th class="border-end border-translucent">Nhân sự</th>
                        <th class="border-end border-translucent">Trạng thái</th>
                        <th class="border-end border-translucent">Email</th>
                        <th class="border-end border-translucent">SĐT</th>
                        <th class="border-end border-translucent">Ngày sinh</th>
                        <th class="border-end border-translucent">Giới tính</th>
                        <th class="border-end border-translucent">Chức vụ</th>
                        <th class="border-end border-translucent">Chi nhánh</th>
                        <th class="border-end border-translucent">BHXH</th>
                        <th class="border-end border-translucent">Mã BHYT</th>
                        <th class="border-end border-translucent">CCCD</th>
                        <th class="border-end border-translucent">Ngày cấp</th>
                        <th class="border-end border-translucent">Nơi cấp</th>
                        <th class="border-end border-translucent">STK</th>
                        <th class="border-end border-translucent">Ngân hàng</th>
                        <th class="border-end border-translucent">Ngày vào làm</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody class="list" id="leal-tables-body">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var employee in Model)
                            {
                                string RenderValue(string? value)
                                {
                                    return string.IsNullOrWhiteSpace(value)
                                        ? "<span class='badge badge-phoenix badge-phoenix-warning'>Chưa cập nhật</span>"
                                        : value;
                                }

                                var avatar = string.IsNullOrWhiteSpace(employee.AvatarUrl)
                                            ? Url.Content("~/assets/img/defaults/avatars/default-avatar.png")
                                            : $"/assets/uploads/avatars/{employee.AvatarUrl}";

                                var badgeClass = employee.IsStatus == 1
                                    ? "badge-phoenix-success"
                                    : "badge-phoenix-danger";

                                var isIncomplete =
                                    string.IsNullOrWhiteSpace(employee.FullName) ||
                                    string.IsNullOrWhiteSpace(employee.Email) ||
                                    string.IsNullOrWhiteSpace(employee.Phone) ||
                                    string.IsNullOrWhiteSpace(employee.PositionName) ||
                                    string.IsNullOrWhiteSpace(employee.BranchName) ||
                                    string.IsNullOrWhiteSpace(employee.StartWorkDate);

                            <tr class="hover-actions-trigger btn-reveal-trigger position-static">

                                <td class="fs-9 align-middle">
                                    <div class="form-check mb-0 fs-8">
                                        <input class="form-check-input"
                                               type="checkbox" />
                                    </div>
                                </td>

                                <td class="name align-middle white-space-nowrap ps-0 border-end border-translucent">
                                    <div class="d-flex align-items-center">

                                        <a asp-action="Detail"
                                           asp-route-id="@employee.Id">

                                            <div class="avatar avatar-xl me-3">
                                                <img class="rounded-circle"
                                                     src="@avatar"
                                                     alt="@(string.IsNullOrWhiteSpace(employee.FullName) ? "Chưa cập nhật họ, tên" : employee.FullName)" />
                                            </div>
                                        </a>

                                        <div>

                                            <a class="fs-8 fw-bold"
                                               href="@($"{RouteConstant.EmployeeDetail}/{employee.Id}")">
                                                @(string.IsNullOrWhiteSpace(employee.FullName) ? "Chưa cập nhật họ, tên" : employee.FullName)
                                            </a>

                                            <div class="d-flex align-items-center">
                                                <p class="mb-0 text-body-highlight fw-semibold fs-9 me-2">
                                                    @employee.EmployeeCode
                                                </p>
                                            </div>

                                        </div>

                                    </div>
                                </td>

                                <td class="email align-middle white-space-nowrap fw-semibold border-end border-translucent">
                                    <span class="badge badge-phoenix @badgeClass">
                                        @employee.StatusText
                                    </span>
                                </td>

                                <td class="email align-middle white-space-nowrap fw-semibold border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.Email))
                                    {
                                        <a class="text-body-highlight"
                                           href="mailto:@employee.Email">
                                            @employee.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="phone align-middle white-space-nowrap fw-semibold border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.Phone))
                                    {
                                        <a class="text-body-highlight"
                                           href="tel:@employee.Phone">
                                            @employee.Phone
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.DateOfBirth))
                                    {
                                        @employee.DateOfBirth
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.Gender))
                                    {
                                        @employee.Gender
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.PositionName))
                                    {
                                        @employee.PositionName
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.BranchName))
                                    {
                                        @employee.BranchName
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle text-center border-end border-translucent">
                                    @if (employee.IsInsurance)
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-success">
                                            Có
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa tham gia
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.HealthInsuranceNumber))
                                    {
                                        @employee.HealthInsuranceNumber
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.IDCardNumber))
                                    {
                                        @employee.IDCardNumber
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.DateOfIssue))
                                    {
                                        @employee.DateOfIssue
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.IssueAuthor))
                                    {
                                        @employee.IssueAuthor
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.CardNumber))
                                    {
                                        @employee.CardNumber
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.BankName))
                                    {
                                        @employee.BankName
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>
                                <td class="align-middle border-end border-translucent">
                                    @if (!string.IsNullOrWhiteSpace(employee.StartWorkDate))
                                    {
                                        @employee.StartWorkDate
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle white-space-nowrap text-end pe-0 ps-4">

                                    <div class="btn-reveal-trigger position-static">

                                        <button class="btn btn-sm dropdown-toggle dropdown-caret-none transition-none btn-reveal fs-10"
                                                type="button"
                                                data-bs-toggle="dropdown">

                                            <span class="fas fa-ellipsis-h fs-10"></span>
                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end py-2">

                                            <a class="dropdown-item"
                                               asp-action="Detail"
                                               asp-route-id="@employee.Id">

                                                Chi tiết
                                            </a>

                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@employee.Id">

                                                Cập nhật
                                            </a>

                                            <div class="dropdown-divider"></div>

                                            <a class="dropdown-item text-danger"
                                               asp-action="Delete"
                                               asp-route-id="@employee.Id">

                                                Xóa nhân sự
                                            </a>

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                Chưa có dữ liệu nhân sự
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>
        <div class="row align-items-center justify-content-end py-4 pe-0 fs-9">
            <div class="col-auto d-flex">
                <p class="mb-0 d-none d-sm-block me-3 fw-semibold text-body" data-list-info="data-list-info"></p><a class="fw-semibold" href="#!" data-list-view="*">View all<span class="fas fa-angle-right ms-1" data-fa-transform="down-1"></span></a><a class="fw-semibold d-none" href="#!" data-list-view="less">View Less<span class="fas fa-angle-right ms-1" data-fa-transform="down-1"></span></a>
            </div>
            <div class="col-auto d-flex">
                <button class="page-link" data-list-pagination="prev"><span class="fas fa-chevron-left"></span></button>
                <ul class="mb-0 pagination"></ul><button class="page-link pe-0" data-list-pagination="next"><span class="fas fa-chevron-right"></span></button>
            </div>
        </div>
    </div>
</div>