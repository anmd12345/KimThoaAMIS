
@using ManagementKimThoa.DTOs.Employee
@using ManagementKimThoa.Constants
@using Microsoft.AspNetCore.Html
@model EmployeeDetailDto

@{
    ViewData["Title"] = "Chi tiết nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@functions {
    public IHtmlContent DisplayValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new HtmlString(
                "<span class='badge badge-phoenix badge-phoenix-warning'>Chưa có dữ liệu</span>");
        }

        return new HtmlString(value);
    }
}

<nav class="mb-3" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@RouteConstant.Dashboard">Bảng điều khiển</a></li>
        <li class="breadcrumb-item active">Nhân sự</li>
        <li class="breadcrumb-item"><a href="@RouteConstant.Employees">Danh sách nhân sự</a></li>
        <li class="breadcrumb-item active">@Model.EmployeeCode</li>
    </ol>
</nav>
<div class="mb-9">
    <div class="row align-items-center justify-content-between g-3 mb-4">
        <div class="col-auto">
            <h2 class="mb-0">Customer details</h2>
        </div>
        <div class="col-auto">
            <div class="row g-3">
                <div class="col-auto"><button class="btn btn-phoenix-info"><span class="fa-solid fa-file me-2"></span>File scan</button></div>
                <div class="col-auto"><button class="btn btn-phoenix-secondary"><span class="fas fa-key me-2"></span>Reset password</button></div>
                <div class="col-auto"><button class="btn btn-phoenix-danger"><span class="fas fa-sign-out-alt me-2"></span>Layoff</button></div>
            </div>
        </div>
    </div>
    <div class="row g-5">

        <!-- LEFT -->
        <div class="col-xl-4">

            <!-- Hồ sơ -->
            <div class="card mb-3">
                <div class="card-body text-center">

                    <img class="rounded-circle mb-3"
                         width="150"
                         src="@(string.IsNullOrEmpty(Model.AvatarUrl)
                            ? "/assets/img/defaults/avatars/default-avatar.png"
                            : $"/assets/uploads/avatars/{Model.AvatarUrl}")" />

                    <h3>
                        @DisplayValue(Model.FullName)
                    </h3>

                    <p class="text-body-secondary">
                        @DisplayValue(Model.EmployeeCode)
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.PositionName))
                    {
                        <span class="badge badge-phoenix badge-phoenix-info">
                            @Model.PositionName
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-phoenix badge-phoenix-warning">
                            Chưa có dữ liệu
                        </span>
                    }

                </div>
            </div>

            <!-- Liên hệ -->
            <div class="card mb-3">
                <div class="card-body">

                    <h4>Liên hệ & Tài khoản</h4>

                    <hr />

                    <p>
                        <span><strong>Email:</strong> @DisplayValue(Model.Email)</span>
                        
                    </p>

                    <p>
                       <span><strong>Số điện thoại:</strong> @DisplayValue(Model.Phone)</span>

                    </p>

                    <p>
                        <span><strong>Chi nhánh:</strong> @DisplayValue(Model.BranchName)</span>
                    </p>

                    <p>
                        <span><strong>Tên tài khoản:</strong> @DisplayValue(Model.Username)</span>

                    </p>
                </div>
            </div>




        </div>

        <!-- RIGHT -->
        <div class="col-xl-8">

            <!-- CCCD -->
            <div class="card mb-3">
                <div class="card-header">
                    <h4>Thông tin nhân sự</h4>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-12 mb-3">
                            <span><strong>Họ và tên: </strong>@DisplayValue(Model.FullName)</span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span><strong>Số CCCD: </strong>@DisplayValue(Model.IDCardNumber)</span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span><strong>Ngày sinh:</strong> @DisplayValue(Model.DateOfBirth)</span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span><strong>Giới tính:</strong> @DisplayValue(Model.Gender)</span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span><strong>Quốc tịch:</strong> @DisplayValue(Model.Nationality)</span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span><strong>Ngày cấp:</strong> @DisplayValue(Model.DateOfIssue)</span>
                            <div></div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span><strong>Nơi cấp:</strong> @DisplayValue(Model.IssueAuthor)</span>
                        </div>

                        @{
                            var permanentAddress =
                                $"{Model.AddressDescription}" +
                                $"{(string.IsNullOrWhiteSpace(Model.AddressDescription) ? "" : ", ")}" +
                                $"{Model.Ward}" +
                                $"{(string.IsNullOrWhiteSpace(Model.Ward) ? "" : ", ")}" +
                                $"{Model.Provinces}";

                            var hasPermanentAddress =
                                !string.IsNullOrWhiteSpace(Model.AddressDescription) ||
                                !string.IsNullOrWhiteSpace(Model.Ward) ||
                                !string.IsNullOrWhiteSpace(Model.Provinces);
                        }

                        <div class="col-md-12 mb-3">
                            <span>
                                <strong>Địa chỉ thường trú:</strong>
                                @if (hasPermanentAddress)
                                {
                                    @permanentAddress
                                }
                                else
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa có dữ liệu
                                    </span>
                                }
                            </span>
                            
                        </div>

                        @{
                            var birthPlace =
                                $"{Model.PlaceOfBirthRegistrationDetail}" +
                                $"{(string.IsNullOrWhiteSpace(Model.PlaceOfBirthRegistrationDetail) ? "" : ", ")}" +
                                $"{Model.PlaceOfBirthRegistrationWard}" +
                                $"{(string.IsNullOrWhiteSpace(Model.PlaceOfBirthRegistrationWard) ? "" : ", ")}" +
                                $"{Model.PlaceOfBirthRegistrationProvince}";

                            var hasBirthPlace =
                                !string.IsNullOrWhiteSpace(Model.PlaceOfBirthRegistrationDetail) ||
                                !string.IsNullOrWhiteSpace(Model.PlaceOfBirthRegistrationWard) ||
                                !string.IsNullOrWhiteSpace(Model.PlaceOfBirthRegistrationProvince);
                        }

                        <div class="col-md-12 mb-3">
                            <span>
                                <strong>Nơi cấp giấy khai sinh:</strong>
                                @if (hasBirthPlace)
                                {
                                    @birthPlace
                                }
                                else
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa có dữ liệu
                                    </span>
                                }
                            </span>
                        </div>

                    </div>

                </div>
            </div>

            <!-- BHXH -->
            <div class="card mb-3">

                <div class="card-header">
                    <h4>
                        Bảo hiểm xã hội
                        @if (Model.IsInsurance)
                        {
                            <span class="badge badge-phoenix badge-phoenix-success">
                                Đã tham gia
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-phoenix badge-phoenix-danger">
                                Chưa tham gia
                            </span>
                        }
                    </h4>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6">
                            <strong>Số BHXH:</strong>
                            <div>@DisplayValue(Model.HealthInsuranceNumber)</div>
                        </div>

                        <div class="col-md-6">
                            <strong>Nơi đăng ký KCB:</strong>
                            <div>@DisplayValue(Model.HospitalRegistration)</div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Ngân hàng -->
            <div class="card mb-3">

                <div class="card-header">
                    <h4>Thông tin ngân hàng</h4>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">
                            <strong>Chủ tài khoản:</strong>
                            <div>@DisplayValue(Model.Cardholder)</div>
                        </div>

                        <div class="col-md-4">
                            <strong>Số tài khoản:</strong>
                            <div>@DisplayValue(Model.CardNumber)</div>
                        </div>

                        <div class="col-md-4">
                            <strong>Ngân hàng:</strong>
                            <div>@DisplayValue(Model.BankName)</div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Ghi chú -->
            <div class="card">

                <div class="card-header">
                    <h4>Ghi chú quản lý</h4>
                </div>

                <div class="card-body">

                    @if (Model.Notes.Any())
                    {
                        foreach (EmployeeNoteDto note in Model.Notes)
                        {
                            <div class="border rounded-3 p-3 mb-3">

                                <div class="d-flex justify-content-between align-items-start mb-2">

                                    <h5 class="mb-0">
                                        @DisplayValue(note.NoteTitle)
                                    </h5>

                                    <span class="badge badge-phoenix badge-phoenix-info">
                                        <span class="text-body-tertiary">
                                            <i class="fas fa-calendar-alt me-1"></i>
                                            @DisplayValue(note.DateCreateNote)
                                        </span>

                                    </span>

                                </div>

                                <div class="text-body-secondary mb-3">
                                    @Html.Raw(note.NoteDescription)
                                </div>

                               
                            </div>
                        }
                    }
                    else
                    {
                        <span class="badge badge-phoenix badge-phoenix-warning">
                            Chưa có ghi chú
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>
</div>