        document.addEventListener("DOMContentLoaded", async () => {

            try {

                const provinceSelect =
                    document.getElementById("province");

                const birthProvinceSelect =
                    document.getElementById("birthProvince");


                provinceData.forEach(province => {

                    const option = `
                        <option value="${province.name}"
                                data-code="${province.code}">
                            ${province.name}
                        </option>
                    `;

                    provinceSelect.innerHTML += option;
                    birthProvinceSelect.innerHTML += option;
                });

            }
            catch (error) {

                console.error("Lỗi tải tỉnh:", error);

            }

        });

        $('#province').on('change', function () {

            const provinceCode =
                $(this).find(':selected').data('code');

            loadWards(provinceCode, '#ward');

        });

        $('#birthProvince').on('change', function () {

            const provinceCode =
                $(this).find(':selected').data('code');

            loadWards(
                provinceCode,
                '#birthWard'
            );

        });


        async function loadWards(provinceCode, wardSelector) {

            const wardSelect = $(wardSelector);

            wardSelect.empty();

            wardSelect.append(
                '<option value="">-- Chọn Phường/Xã --</option>'
            );

            if (!provinceCode) {

                wardSelect.prop('disabled', true);
                return;
            }

            try {

                const response =
                    await fetch(`/GetProvince?code=${provinceCode}`);

                const province =
                    await response.json();

                province.wards.forEach(ward => {

                    wardSelect.append(`
                <option value="${ward.name}">
                    ${ward.name}
                </option>
            `);

                });

                wardSelect.prop('disabled', false);

                wardSelect.trigger('change');

            }
            catch (e) {

                console.error(e);

            }
        }



    </script>

