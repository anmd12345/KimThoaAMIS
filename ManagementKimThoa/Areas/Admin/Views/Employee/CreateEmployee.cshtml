@using ManagementKimThoa.DTOs.Employee
@using ManagementKimThoa.Constants
@using ManagementKimThoa.DTOs.Position
@using ManagementKimThoa.DTOs.Branch
@using ManagementKimThoa.DTOs.Role
@model EmployeeCreateDto

@{
    ViewData["Title"] = "Thêm nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    List<PositionDto> positions = ViewBag.positions == null ? new List<PositionDto>() : ViewBag.positions;
    List<BranchDto> branchs = ViewBag.branchs == null ? new List<BranchDto>() : ViewBag.branchs;
    List<RoleDto> roles = ViewBag.roles;
}

@section Styles{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        /* Sửa một chút chiều cao hiển thị cho khớp với form của Phoenix */
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 46px;
            padding: 0.5rem 0.75rem;
        }
    </style>

    <style>

        .cursor-pointer {
            cursor: pointer;
        }

        #avatarPreview {
            transition: all .25s ease;
        }

        label[for="avatarInput"]:hover #avatarPreview {
            opacity: .75;
            transform: scale(1.03);
        }
    </style>


}

<nav class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a href="@RouteConstant.Dashboard">Bảng điều khiển</a>
        </li>

        <li class="breadcrumb-item">
            <a href="@RouteConstant.Employees">Nhân sự</a>
        </li>

        <li class="breadcrumb-item active">
            Thêm nhân sự
        </li>
    </ol>
</nav>

<div class="border-bottom border-translucent mb-5 pb-3">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Thêm nhân sự</h2>

        <div>
            <a href="@RouteConstant.Employees"
               class="btn btn-phoenix-secondary me-2">
                Hủy
            </a>

            <button type="submit"
                    form="employeeForm"
                    class="btn btn-primary">
                Lưu nhân sự
            </button>
        </div>
    </div>
</div>

<form id="employeeForm"
      method="post"
      enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <!-- Avatar -->

    <div class="card mb-4">

        <div class="card-header">
            <h4>Ảnh đại diện</h4>
        </div>

        <div class="card-body">

            <div class="d-flex flex-column align-items-center">

                <!-- Input ẩn -->
                <input name="AvatarFile"
                       type="file"
                       class="d-none"
                       accept="image/*"
                       id="avatarInput" />

                <!-- Avatar Preview -->
                <label for="avatarInput"
                       class="position-relative cursor-pointer">

                    <img id="avatarPreview"
                         src="@Url.Content("~/assets/img/defaults/avatars/default-avatar.png")"
                         class="rounded-circle border shadow-sm"
                         style="width:180px;height:180px;object-fit:cover;" />

                    <!-- Overlay camera -->
                    <div class="position-absolute bottom-0 end-0">

                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow"
                             style="width:42px;height:42px;">

                            <i class="fas fa-camera"></i>

                        </div>

                    </div>

                </label>

                <small class="text-muted mt-3">
                    Nhấn vào ảnh để thay đổi ảnh đại diện
                </small>

            </div>

        </div>

    </div>
    <!-- Tài khoản -->

    <div class="card mb-4">
        <div class="card-header">
            <h4>Tài khoản đăng nhập</h4>
        </div>

        <div class="card-body row g-3">

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text"
                           name="Username"
                           value="@Model?.Username"
                           class="form-control" placeholder="" />
                    <label>Tên đăng nhập</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="password"
                           name="Password"
                           class="form-control" placeholder="" />
                    <label>Mật khẩu</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating">
                    <select name="RoleId" class="form-select">
                        <option value="">-- Phân quyền --</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role.Id">
                                @if (role.RoleName == RoleConstant.Manage)
                                {
                                    <span>Quản lý</span>
                                }
                                else if (role.RoleName == RoleConstant.Accountant)
                                {
                                    <span>Kế toán</span>
                                }
                                else if (role.RoleName == RoleConstant.Warehouse)
                                {
                                    <span>Nhân viên kho</span>
                                }
                                else if (role.RoleName == RoleConstant.SalesAgent)
                                {

                                    <span>Nhân viên bán hàng</span>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </option>
                        }

                    </select>
                    <label>Vai trò</label>
                </div>
            </div>

        </div>
    </div>

    <!-- Thông tin CCCD -->

    <div class="card mb-4">

        <div class="card-header">
            <h4>Thông tin cá nhân</h4>
        </div>

        <div class="card-body row g-3">

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text"
                           name="FullName"
                           value="@Model?.FullName"
                           class="form-control" placeholder="" />
                    <label>Họ và tên</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="date"
                           name="DateOfBirth"
                           value="@Model?.DateOfBirth"
                           class="form-control" />
                    <label>Ngày sinh</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <select name="HomeTown" class="form-select">
                        <option value="">-- Chọn quê quán --</option>
                        <option value="Tiền Giang" selected="@(Model?.HomeTown == "Tiền Giang")">
                            Tiền Giang
                        </option>
                    </select>
                    <label>Quê quán</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <select name="Gender" class="form-select">

                        <option value="">Chọn</option>

                        @if (Model?.Gender == "Nam")
                        {
                            <option value="Nam" selected>Nam</option>
                        }
                        else
                        {
                            <option value="Nam">Nam</option>
                        }

                        @if (Model?.Gender == "Nữ")
                        {
                            <option value="Nữ" selected>Nữ</option>
                        }
                        else
                        {
                            <option value="Nữ">Nữ</option>
                        }

                        @if (Model?.Gender == "Khác")
                        {
                            <option value="Khác" selected>Khác</option>
                        }
                        else
                        {
                            <option value="Khác">Khác</option>
                        }

                    </select>
                    <label>Giới tính</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <select name="Nationality" class="form-select">
                        <option value="">-- Chọn quốc tịch --</option>
                        <option value="Việt Nam" selected="@(Model?.Nationality == "Việt Nam")">
                            Việt Nam
                        </option>
                        <option value="Khác">
                            Khác
                        </option>
                    </select>
                    <label>Quốc tịch</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input type="text"
                           name="IDCardNumber"
                           value="@Model?.IDCardNumber"
                           class="form-control" placeholder="" />
                    <label>Số CCCD</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <input type="date"
                           name="DateOfIssue"
                           value="@Model?.DateOfIssue"
                           class="form-control" />
                    <label>Ngày cấp</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <select name="IssueAuthor" class="form-select">
                        <option value="">-- Chọn nơi cấp --</option>
                        <option value="Cục cảnh sát QLHC về TTXH" selected="@(Model?.IssueAuthor == "Cục cảnh sát QLHC về TTXH")">
                            Cục cảnh sát QLHC về TTXH
                        </option>
                        <option value="Khác">
                            Khác
                        </option>
                    </select>
                    <label>Nơi cấp</label>
                </div>
            </div>
            <hr />

            <h4>Địa chỉ thường trú</h4>

            <div class="col-md-6">
                <div class="form-floating">
                    <select id="province"
                            name="Provinces"
                            class="form-select select2">
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <select id="ward"
                            name="Ward"
                            class="form-select select2"
                            disabled>
                        <option value="">-- Chọn Phường/Xã --</option>
                    </select>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating">
                    <textarea class="form-control" name="AddressDescription" id="AddressDescription" placeholder="" style="height: 128px"></textarea>
                    <label for="AddressDescription">Địa chỉ chi tiết</label>
                </div>
            </div>

            <hr />

            <h4>Nơi đăng ký khai sinh</h4>

            <div class="col-md-6">
                <div class="form-floating">
                    <!-- Nơi đăng ký khai sinh -->
                    <select id="birthProvince"
                            name="PlaceOfBirthRegistrationProvince"
                            class="form-select select2">
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <select id="birthWard"
                            name="PlaceOfBirthRegistrationWard"
                            class="form-select select2"
                            disabled>
                        <option value="">-- Chọn Phường/Xã --</option>
                    </select>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating">
                    <textarea class="form-control" name="PlaceOfBirthRegistrationDetail" id="PlaceOfBirthRegistrationDetail" placeholder="" style="height: 128px"></textarea>
                    <label for="PlaceOfBirthRegistrationDetail">Địa chỉ chi tiết</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông tin làm việc -->

    <div class="card mb-4">

        <div class="card-header">
            <h4>Thông tin làm việc</h4>
        </div>

        <div class="card-body row g-3">

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text"
                           name="Phone"
                           value="@Model?.Phone"
                           class="form-control" placeholder="" />
                    <label>Số điện thoại</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="email"
                           name="Email"
                           value="@Model?.Email"
                           class="form-control" placeholder="" />
                    <label>Email</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating">
                    <input type="date"
                           name="StartWorkDate"
                           value="@Model?.StartWorkDate"
                           class="form-control" />
                    <label>Ngày vào làm</label>
                </div>
            </div>

            <div class="col-md-6">

                <div class="form-floating">

                    <select name="PositionId" class="form-select">

                        <option value="">-- Chọn chức vụ --</option>

                        @foreach (PositionDto position in positions)
                        {
                            if (Model?.PositionId == position.Id)
                            {
                                <option value="@position.Id" selected>
                                    @position.PositionName
                                </option>
                            }
                            else
                            {
                                <option value="@position.Id">
                                    @position.PositionName
                                </option>
                            }
                        }

                    </select>

                    <label>Chức vụ</label>

                </div>

            </div>

            <div class="col-md-6">

                <div class="form-floating">

                    <select name="BranchId" class="form-select">

                        <option value="">-- Chọn chi nhánh --</option>

                        @foreach (BranchDto branch in branchs)
                        {
                            if (Model?.BranchId == branch.Id)
                            {
                                <option value="@branch.Id" selected>
                                    @branch.BranchName
                                </option>
                            }
                            else
                            {
                                <option value="@branch.Id">
                                    @branch.BranchName
                                </option>
                            }
                        }

                    </select>

                    <label>Chi nhánh</label>

                </div>

            </div>

        </div>

    </div>

    <!-- BHXH -->

    <div class="card mb-4">

        <div class="card-header">
            <h4>Bảo hiểm xã hội</h4>
        </div>

        <div class="card-body row g-3">

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text"
                           name="HealthInsuranceNumber"
                           value="@Model?.HealthInsuranceNumber"
                           class="form-control" placeholder="" />
                    <label>Số BHXH</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text"
                           name="HospitalRegistration"
                           value="@Model?.HospitalRegistration"
                           class="form-control" placeholder="" />
                    <label>Nơi đăng ký KCB</label>
                </div>
            </div>

        </div>

    </div>

    <!-- Ngân hàng -->

    <div class="card mb-4">

        <div class="card-header">
            <h4>Thông tin ngân hàng</h4>
        </div>

        <div class="card-body row g-3">

            <div class="col-md-4">
                <div class="form-floating">
                    <input type="text"
                           name="Cardholder"
                           value="@Model?.Cardholder"
                           class="form-control" placeholder="" />
                    <label>Chủ tài khoản</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input type="text"
                           name="CardNumber"
                           value="@Model?.CardNumber"
                           class="form-control" placeholder="" />
                    <label>Số tài khoản</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <select name="BankName" class="form-select select2">
                        <option value="">-- Chọn ngân hàng --</option>

                        <!-- Nhóm Big 4 (Nhà nước) -->
                        <option value="Vietcombank" selected="@(Model?.BankName == "Vietcombank")">Vietcombank (NH Ngoại thương)</option>
                        <option value="VietinBank" selected="@(Model?.BankName == "VietinBank")">VietinBank (NH Công thương)</option>
                        <option value="BIDV" selected="@(Model?.BankName == "BIDV")">BIDV (NH Đầu tư và Phát triển)</option>
                        <option value="Agribank" selected="@(Model?.BankName == "Agribank")">Agribank (NH Nông nghiệp & PTNT)</option>

                        <!-- Nhóm TMCP lớn & Phổ biến -->
                        <option value="Techcombank" selected="@(Model?.BankName == "Techcombank")">Techcombank (NH Kỹ thương)</option>
                        <option value="MB Bank" selected="@(Model?.BankName == "MB Bank")">MB Bank (NH Quân đội)</option>
                        <option value="VPBank" selected="@(Model?.BankName == "VPBank")">VPBank (NH Việt Nam Thịnh Vượng)</option>
                        <option value="ACB" selected="@(Model?.BankName == "ACB")">ACB (NH Á Châu)</option>
                        <option value="Sacombank" selected="@(Model?.BankName == "Sacombank")">Sacombank (NH Sài Gòn Thương Tín)</option>
                        <option value="HDBank" selected="@(Model?.BankName == "HDBank")">HDBank (NH Phát triển TP.HCM)</option>
                        <option value="VIB" selected="@(Model?.BankName == "VIB")">VIB (NH Quốc tế)</option>
                        <option value="TPBank" selected="@(Model?.BankName == "TPBank")">TPBank (NH Tiên Phong)</option>
                        <option value="SHB" selected="@(Model?.BankName == "SHB")">SHB (NH Sài Gòn - Hà Nội)</option>
                        <option value="MSB" selected="@(Model?.BankName == "MSB")">MSB (NH Hàng Hải)</option>
                        <option value="LPBank" selected="@(Model?.BankName == "LPBank")">LPBank (NH Lộc Phát Việt Nam)</option>
                        <option value="OCB" selected="@(Model?.BankName == "OCB")">OCB (NH Phương Đông)</option>
                        <option value="SeABank" selected="@(Model?.BankName == "SeABank")">SeABank (NH Đông Nam Á)</option>
                        <option value="Eximbank" selected="@(Model?.BankName == "Eximbank")">Eximbank (NH Xuất Nhập Khẩu)</option>
                        <option value="Nam A Bank" selected="@(Model?.BankName == "Nam A Bank")">Nam A Bank (NH Nam Á)</option>
                        <option value="Bac A Bank" selected="@(Model?.BankName == "Bac A Bank")">Bac A Bank (NH Bắc Á)</option>
                        <option value="ABBANK" selected="@(Model?.BankName == "ABBANK")">ABBANK (NH An Bình)</option>
                        <option value="PVcomBank" selected="@(Model?.BankName == "PVcomBank")">PVcomBank (NH Đại Chúng)</option>
                        <option value="BVBank" selected="@(Model?.BankName == "BVBank")">BVBank (NH Bản Việt)</option>
                        <option value="Vietbank" selected="@(Model?.BankName == "Vietbank")">Vietbank (NH Việt Nam Thương Tín)</option>
                        <option value="Kienlongbank" selected="@(Model?.BankName == "Kienlongbank")">Kienlongbank (NH Kiên Long)</option>
                        <option value="Saigonbank" selected="@(Model?.BankName == "Saigonbank")">Saigonbank (NH Sài Gòn Công Thương)</option>
                        <option value="PGBank" selected="@(Model?.BankName == "PGBank")">PGBank (NH Thịnh vượng & Phát triển)</option>
                        <option value="BaoViet Bank" selected="@(Model?.BankName == "BaoViet Bank")">BaoViet Bank (NH Bảo Việt)</option>

                        <!-- Nhóm nước ngoài phổ biến -->
                        <option value="Shinhan Bank" selected="@(Model?.BankName == "Shinhan Bank")">Shinhan Bank</option>
                        <option value="HSBC" selected="@(Model?.BankName == "HSBC")">HSBC Việt Nam</option>
                    </select>
                </div>
            </div>

        </div>

    </div>

</form>

