                    <div class="col-md-6 mb-3">
                        <strong>Địa chỉ thường trú:</strong>

                        <div class="mt-2">
                            <div>
                                <i>Tỉnh/Thành phố:</i>
                                @(string.IsNullOrWhiteSpace(Model?.IDCard?.Provinces)
                ? "Chưa cập nhật"
                : Model.IDCard.Provinces)
                            </div>

                            <div>
                                <i>Phường/Xã:</i>
                                @(string.IsNullOrWhiteSpace(Model?.IDCard?.Ward)
                ? "Chưa cập nhật"
                : Model.IDCard.Ward)
                            </div>

                            <div>
                                <i>Địa chỉ chi tiết:</i>
                                @(string.IsNullOrWhiteSpace(Model?.IDCard?.AddressDescription)
                ? "Chưa cập nhật"
                : Model.IDCard.AddressDescription)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Nơi đăng ký khai sinh:</strong>

                        <ul class="list-unstyled mt-2 mb-0">
                            <li>
                                <i class="text-body-secondary">Tỉnh/Thành phố:</i>
                                @(string.IsNullOrWhiteSpace(Model?.OtherInfor?.PlaceOfBirthRegistrationProvince)
                ? "Chưa cập nhật"
                : Model.OtherInfor.PlaceOfBirthRegistrationProvince)
                            </li>

                            <li>
                                <i class="text-body-secondary">Phường/Xã:</i>
                                @(string.IsNullOrWhiteSpace(Model?.OtherInfor?.PlaceOfBirthRegistrationWard)
                ? "Chưa cập nhật"
                : Model.OtherInfor.PlaceOfBirthRegistrationWard)
                            </li>

                            <li>
                                <i class="text-body-secondary">Địa chỉ chi tiết:</i>
                                @(string.IsNullOrWhiteSpace(Model?.OtherInfor?.PlaceOfBirthRegistrationDetail)
                ? "Chưa cập nhật"
                : Model.OtherInfor.PlaceOfBirthRegistrationDetail)
                            </li>
                        </ul>
                    </div>


                </div>

            </div>

            <div class="card mb-3">

                <div class="card-header">
                    <h4>Thông tin làm việc</h4>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">
                            <strong>Chức vụ</strong>
                            <div>
                                @if (string.IsNullOrEmpty(Model?.Role?.RoleName))
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                                else
                                {
                                    @Model.Role?.RoleName
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <strong>Chi nhánh</strong>
                            <div>
                                @if (string.IsNullOrEmpty(Model?.OtherInfor?.Branch?.BranchName))
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                                else
                                {
                                    @Model.OtherInfor?.Branch?.BranchName
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <strong>Ngày vào làm</strong>
                            <div>
                                @if (Model != null && Model.OtherInfor != null && !string.IsNullOrEmpty(Model.OtherInfor.StartWorkDate))
                                {
                                    @DateTime.Parse(Model?.OtherInfor?.StartWorkDate).ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- BHXH -->
            <div class="card mb-3">

                <div class="card-header">

                    <h4>

                        Bảo hiểm xã hội

                        @if (Model.OtherInfor?.IsInsurance == true)
                        {
                            <span class="badge badge-phoenix badge-phoenix-success">
                                Đã tham gia
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-phoenix badge-phoenix-danger">
                                Chưa tham gia
                            </span>
                        }

                    </h4>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6">
                            <strong>Số BHXH</strong>
                            <div>

                                @if (string.IsNullOrEmpty(Model?.HealthInsurance?.HealthInsuranceNumber))
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                                else
                                {
                                    @Model.HealthInsurance?.HealthInsuranceNumber
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <strong>Nơi đăng ký KCB</strong>
                            <div>

                                @if (string.IsNullOrEmpty(Model?.HealthInsurance?.HospitalRegistration))
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                                else
                                {
                                    @Model.HealthInsurance?.HospitalRegistration
                                }
                            </div>
                        </div>

                    </div>

                </div>

            </div>
            <!-- Ngân hàng -->
            <div class="card mb-3">

                <div class="card-header">
                    <h4>Thông tin ngân hàng</h4>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">
                            <strong>Chủ tài khoản</strong>
                            <div>

                                @if (string.IsNullOrEmpty(Model?.BankInfo?.Cardholder))
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                                else
                                {
                                    @Model.BankInfo?.Cardholder
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <strong>Số tài khoản</strong>
                            <div>

                                @if (string.IsNullOrEmpty(@Model?.BankInfo?.CardNumber))
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                                else
                                {
                                    @Model.BankInfo?.CardNumber
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <strong>Ngân hàng</strong>
                            <div>

                                @if (string.IsNullOrEmpty(Model?.BankInfo?.BankName))
                                {
                                    <span class="badge badge-phoenix badge-phoenix-warning">
                                        Chưa cập nhật
                                    </span>
                                }
                                else
                                {
                                    @Model.BankInfo?.BankName
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ghi chú -->
            <div class="card">

                <div class="card-header">
                    <h4>Ghi chú</h4>
                </div>

                <div class="card-body">

                    @if (Model.Notes.Any())
                    {
                        foreach (var note in Model.Notes)
                        {
                            <div class="border rounded-3 p-3 mb-3">

                                <div class="d-flex justify-content-between">

                                    <h5>
                                        @note?.NoteTitle
                                    </h5>

                                    <span class="badge badge-phoenix badge-phoenix-info">
                                        @note?.DateCreateNote
                                    </span>

                                </div>

                                <div>
                                    @Html.Raw(note?.NoteDescription)
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <span class="badge badge-phoenix badge-phoenix-warning">
                            Chưa có ghi chú
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>