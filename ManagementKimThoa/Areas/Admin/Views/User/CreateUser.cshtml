                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <label>Giới tính</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <select name="IDCard.Nationality" class="form-select">
                        <option value="">-- Chọn quốc tịch --</option>
                        <option value="Việt Nam">Việt Nam</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <label>Quốc tịch</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <input type="text" name="IDCard.IDCardNumber" class="form-control" placeholder="" />
                    <label>Số CCCD</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <input type="date" name="IDCard.DateOfIssue" class="form-control" />
                    <label>Ngày cấp</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <select name="IDCard.IssueAuthor" class="form-select">
                        <option value="">-- Chọn nơi cấp --</option>
                        <option value="Cục cảnh sát QLHC về TTXH">Cục cảnh sát QLHC về TTXH</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <label>Nơi cấp</label>
                </div>
            </div>

            <hr />
            <h4>Địa chỉ thường trú</h4>
            <div class="col-md-6">
                <div class="form-floating">
                    <select id="province" name="IDCard.Provinces" class="form-select select2">
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <select id="ward" name="IDCard.Ward" class="form-select select2" disabled>
                        <option value="">-- Chọn Phường/Xã --</option>
                    </select>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating">
                    <textarea class="form-control" name="IDCard.AddressDescription" id="AddressDescription" placeholder="" style="height: 128px"></textarea>
                    <label for="AddressDescription">Địa chỉ chi tiết</label>
                </div>
            </div>

            <hr />
            <h4>Nơi đăng ký khai sinh</h4>
            <div class="col-md-6">
                <div class="form-floating">
                    <select id="birthProvince" name="OtherInfor.PlaceOfBirthRegistrationProvince" class="form-select select2">
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <select id="birthWard" name="OtherInfor.PlaceOfBirthRegistrationWard" class="form-select select2" disabled>
                        <option value="">-- Chọn Phường/Xã --</option>
                    </select>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating">
                    <textarea class="form-control" name="OtherInfor.PlaceOfBirthRegistrationDetail" id="PlaceOfBirthRegistrationDetail" placeholder="" style="height: 128px"></textarea>
                    <label for="PlaceOfBirthRegistrationDetail">Địa chỉ chi tiết</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h4>Thông tin làm việc</h4></div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text" name="OtherInfor.Phone" class="form-control" placeholder="" />
                    <label>Số điện thoại</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="email" name="OtherInfor.Email" class="form-control" placeholder="" />
                    <label>Email</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating">
                    <input type="date" name="OtherInfor.StartWorkDate" class="form-control" />
                    <label>Ngày vào làm</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <select name="OtherInfor.Position.Id" class="form-select">
                        <option value="">-- Chọn chức vụ --</option>
                        @foreach (PositionDto position in positions)
                        {
                            <option value="@position.Id">@position.PositionName</option>
                        }
                    </select>
                    <label>Chức vụ</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <select name="OtherInfor.Branch.Id" class="form-select">
                        <option value="">-- Chọn chi nhánh --</option>
                        @foreach (BranchDto branch in branchs)
                        {
                            <option value="@branch.Id">@branch.BranchName</option>
                        }
                    </select>
                    <label>Chi nhánh</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h4>Bảo hiểm xã hội</h4></div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <div class="form-check mt-3">
                    <input class="form-check-input"
                           type="checkbox"
                           id="IsInsurance"
