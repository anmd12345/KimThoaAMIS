@using ManagementKimThoa.Constants
@using ManagementKimThoa.DTOs.Position
@using ManagementKimThoa.DTOs.Branch
@using ManagementKimThoa.DTOs.Role

@{
    ViewData["Title"] = "Thêm nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var positions = ViewBag.positions as List<PositionDto> ?? new List<PositionDto>();
    var branchs = ViewBag.branchs as List<BranchDto> ?? new List<BranchDto>();
    var roles = ViewBag.roles as List<RoleDto> ?? new List<RoleDto>();
}

@section Styles{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        /* Đồng bộ chiều cao hiển thị khớp với form Phoenix */
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 46px;
            padding: 0.5rem 0.75rem;
        }

        .cursor-pointer {
            cursor: pointer;
        }

        #avatarPreview, #profilePreviewContainer {
            transition: all .25s ease;
        }

        label[for="avatarInput"]:hover #avatarPreview {
            opacity: .75;
            transform: scale(1.03);
        }

        label[for="profileScanInput"]:hover #profilePreviewContainer {
            opacity: .85;
            transform: scale(1.03);
        }

        #btnClearProfileFile {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            padding: 0;
            z-index: 9999;
        }

        #profileImagePreview, #profileFilePreview {
            position: relative;
            z-index: 1;
        }
    </style>
}

<nav class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@RouteConstant.Dashboard">Bảng điều khiển</a></li>
        <li class="breadcrumb-item"><a href="@RouteConstant.Users">Nhân sự</a></li>
        <li class="breadcrumb-item active">Thêm nhân sự</li>
    </ol>
</nav>

<div class="border-bottom border-translucent mb-5 pb-3">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Thêm nhân sự</h2>
        <div>
            <a href="@RouteConstant.Users" class="btn btn-phoenix-secondary me-2">Hủy</a>
            <button type="submit" form="employeeForm" class="btn btn-primary">Lưu nhân sự</button>
        </div>
    </div>
</div>

<form id="employeeForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="card mb-4">
        <div class="card-header"><h4>Ảnh đại diện</h4></div>
        <div class="card-body">
            <div class="d-flex flex-column align-items-center">
                <input name="AvatarFile" type="file" class="d-none" accept="image/*" id="avatarInput" />
                <label for="avatarInput" class="position-relative cursor-pointer">
                    <img id="avatarPreview" src="@Url.Content("~/assets/img/defaults/avatars/default-avatar.png")"
                         class="rounded-circle border shadow-sm" style="width:180px;height:180px;object-fit:cover;" />
                    <div class="position-absolute bottom-0 end-0">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width:42px;height:42px;">
                            <i class="fas fa-camera"></i>
                        </div>
                    </div>
                </label>
                <small class="text-muted mt-3">Nhấn vào ảnh để thay đổi ảnh đại diện</small>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h4>Hồ sơ scan</h4></div>
        <div class="card-body">
            <div class="d-flex flex-column align-items-center">
                <input name="ProfileScanFile" type="file" class="d-none" id="profileScanInput" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                <label for="profileScanInput" class="cursor-pointer">
                    <div id="profilePreviewContainer" class="border rounded d-flex align-items-center justify-content-center shadow-sm bg-light position-relative" style="width:220px;height:220px;overflow:hidden;">
                        <button type="button" id="btnClearProfileFile" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 d-none">
                            <i class="fas fa-times"></i>
                        </button>
                        <div id="defaultProfilePreview" class="text-center">
                            <i class="fas fa-file-upload fa-4x text-secondary"></i>
                            <div class="mt-3">Chọn hồ sơ scan</div>
                        </div>
                        <img id="profileImagePreview" class="d-none" style="width:100%;height:100%;object-fit:cover;" />
                        <iframe id="profilePdfPreview" class="d-none border-0" style="width:100%;height:100%;"></iframe>
                        <div id="profileFilePreview" class="d-none text-center p-3">
                            <i id="profileFileIcon" class="fa-5x mb-3"></i>
                            <div id="profileFileName" class="small fw-semibold"></div>
                            <div class="text-muted mt-2">Không hỗ trợ xem trước Word trực tiếp</div>
                        </div>
                    </div>
                </label>
                <small class="text-muted mt-3">Hỗ trợ JPG, PNG, PDF, DOC, DOCX</small>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h4>Tài khoản đăng nhập</h4></div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text" name="Account.Username" class="form-control" placeholder="" />
                    <label>Tên đăng nhập</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="password" name="Account.Password" class="form-control" placeholder="" />
                    <label>Mật khẩu</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating">
                    <select name="Role.Id" class="form-select">
                        <option value="">-- Phân quyền & Chức vụ --</option>
                        @foreach (var role in roles)
                        {
                            var roleNameVi = role.RoleName switch
                            {
                                RoleConstant.Manage => "Quản lý",
                                RoleConstant.Accountant => "Kế toán",
                                RoleConstant.Warehouse => "Nhân viên kho",
                                RoleConstant.SalesAgent => "Nhân viên bán hàng",
                                _ => role.RoleName
                            };
                            <option value="@role.Id">@roleNameVi</option>
                        }
                    </select>
                    <label>Vai trò</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h4>Thông tin cá nhân</h4></div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text" name="IDCard.FullName" class="form-control" placeholder="" />
                    <label>Họ và tên</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="date" name="IDCard.DateOfBirth" class="form-control" />
                    <label>Ngày sinh</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <select id="homeTown" name="IDCard.HomeTown" class="form-select select2">
                        <option value="">-- Chọn quê quán --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <select name="IDCard.Gender" class="form-select">
