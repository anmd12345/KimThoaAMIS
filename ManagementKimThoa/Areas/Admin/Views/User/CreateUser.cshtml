                <div class="mb-3">
                    <label class="form-label">
                        Tiêu đề
                    </label>

                    <input type="text"
                           class="form-control note-title">
                </div>

                <div>
                    <label class="form-label">
                        Nội dung
                    </label>

                    <textarea rows="4"
                              class="form-control note-description"></textarea>
                </div>

            </div>
        </div>

    </template>
</form>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/assets/js/province.js"></script>

    <!-- Place the first <script> tag in your HTML's <head> -->
    <script src="https://cdn.tiny.cloud/1/knomrrtoejbhyvpv9jjulyqaj0ndmqzvy2dxq64mr7co0wz8/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

    <!-- Place the following <script> and <textarea> tags your HTML's <body> -->
    <script>

        function initNoteEditor(element) {

            tinymce.init({
                target: element,
                height: 300,

                plugins: [
                    'anchor',
                    'autolink',
                    'charmap',
                    'codesample',
                    'emoticons',
                    'image',
                    'link',
                    'lists',
                    'media',
                    'searchreplace',
                    'table',
                    'visualblocks',
                    'wordcount'
                ],

                toolbar:
                    'undo redo | blocks | ' +
                    'bold italic underline | ' +
                    'alignleft aligncenter alignright | ' +
                    'bullist numlist | ' +
                    'link image table | removeformat'
            });

        }
        let noteIndex = 0;

        $("#btnAddNote").click(function () {

            const template =
                document.querySelector("#noteTemplate");

            const clone =
                template.content.cloneNode(true);

            $(clone)
                .find(".note-title")
                .attr("name",
                    `Notes[${noteIndex}].NoteTitle`);

            $(clone)
                .find(".note-description")
                .attr("name",
                    `Notes[${noteIndex}].NoteDescription`);

            $("#notesContainer")
                .append(clone);

            const textarea = document.querySelector('.note-description')

            initNoteEditor(textarea);
            noteIndex++;
        });

        $(document).on(
            "click",
            ".btn-remove-note",
            function () {

                $(this)
                    .closest(".note-item")
                    .remove();

                rebuildNoteIndexes();
            });

        function rebuildNoteIndexes() {

            $("#notesContainer .note-item")
                .each(function (index) {

                    $(this)
                        .find(".note-title")
                        .attr("name",
                            `Notes[${index}].NoteTitle`);

                    $(this)
                        .find(".note-description")
                        .attr("name",
                            `Notes[${index}].NoteDescription`);
                });

            noteIndex = $("#notesContainer .note-item").length;
        }


        $("#employeeForm").submit(function () {
            tinymce.triggerSave();
        }); 
    </script>


    <script>
        let provinces = [];
        let provinceMap = new Map();

        $(document).ready(function () {

            try {

                // Load dữ liệu 1 lần duy nhất
                provinces = getProvinces();

                // Cache để lookup O(1)
                provinceMap = new Map(
                    provinces.map(x => [x.code, x])
                );

                console.log(provinces[0]);

                // Render tỉnh thành trước
                loadProvinceOptions();

                // Sau đó mới init Select2
                $('.select2').select2({
                    theme: 'bootstrap-5',
                    width: '100%'
                });

                // Cascading dropdown
                $('#province').on('change', function () {

                    const provinceCode =
                        $(this)
                            .find(':selected')
                            .data('code');
                    console.log(provinceCode);
                    loadWards(
                        provinceCode,
                        '#ward'
                    );

                });

                $('#birthProvince').on('change', function () {

                    const provinceCode =
                        $(this)
                            .find(':selected')
                            .data('code');
                    console.log(provinceCode);
                    loadWards(
                        provinceCode,
                        '#birthWard'
                    );

                });

            }
            catch (error) {

                console.error(
                    'Lỗi tải dữ liệu tỉnh thành:',
                    error
                );

            }

        });

        function loadProvinceOptions() {

            const optionsHtml = provinces
                .map(province => `
                    <option value="${province.name}"
                            data-code="${province.code}">
                        ${province.name}
                    </option>
                `)
                .join('');

            $('#province,#birthProvince,#homeTown')
                .append(optionsHtml);

        }

        function loadWards(
            provinceCode,
            wardSelector,
            selectedWard = null
        ) {

            const wardSelect = $(wardSelector);

            wardSelect.empty();

            wardSelect.append(`
                <option value="">
                    -- Chọn Phường/Xã --
                </option>
            `);

            if (!provinceCode) {

                wardSelect
                    .prop('disabled', true)
                    .trigger('change');

                return;
            }

            const province =
                provinceMap.get(Number(provinceCode));

            if (!province) {

                wardSelect
                    .prop('disabled', true)
                    .trigger('change');

                return;
            }

            const wardOptions = province.wards
                .map(ward => {

                    const selected =
                        ward.name === selectedWard
                            ? 'selected'
                            : '';

                    return `
                        <option value="${ward.name}"
                                ${selected}>
                            ${ward.name}
                        </option>
                    `;
                })
                .join('');

            wardSelect
                .append(wardOptions)
                .prop('disabled', false)
                .trigger('change');
        }</script>


    <script>
        

        // Logic tương tác File Upload & Live Preview
        document.getElementById("profileScanInput").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const imagePreview = document.getElementById("profileImagePreview");
            const filePreview = document.getElementById("profileFilePreview");
            const defaultPreview = document.getElementById("defaultProfilePreview");
            const fileIcon = document.getElementById("profileFileIcon");
            const fileName = document.getElementById("profileFileName");
            const clearButton = document.getElementById("btnClearProfileFile");
            const pdfPreview = document.getElementById("profilePdfPreview");

            // Reset tất cả trạng thái hiển thị ban đầu
            [imagePreview, filePreview, defaultPreview, pdfPreview].forEach(el => el.classList.add("d-none"));
            clearButton.classList.remove("d-none");

            const extension = file.name.split('.').pop().toLowerCase();

            if (['jpg', 'jpeg', 'png'].includes(extension)) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    imagePreview.src = event.target.result;
                    imagePreview.classList.remove("d-none");
                };
                reader.readAsDataURL(file);
            } else if (extension === "pdf") {
                pdfPreview.src = URL.createObjectURL(file);
                pdfPreview.classList.remove("d-none");
            } else if (['doc', 'docx'].includes(extension)) {
                fileIcon.className = "fas fa-file-word fa-5x text-primary";
                fileName.innerText = file.name;
                filePreview.classList.remove("d-none");
            } else {
                fileIcon.className = "fas fa-file fa-5x text-secondary";
                fileName.innerText = file.name;
                filePreview.classList.remove("d-none");
            }
        });

        // Bổ sung: Hoàn thiện chức năng Nút xóa file hồ sơ scan
        document.getElementById("btnClearProfileFile").addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();
            document.getElementById("profileScanInput").value = "";
            document.getElementById("profileImagePreview").classList.add("d-none");
            document.getElementById("profileFilePreview").classList.add("d-none");
            document.getElementById("profilePdfPreview").classList.add("d-none");
            document.getElementById("defaultProfilePreview").classList.remove("d-none");
            this.classList.add("d-none");
        });

        // Bổ sung: Xử lý Live Preview cho Ảnh đại diện khi chọn file
        document.getElementById("avatarInput").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById("avatarPreview").src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });</script>
}