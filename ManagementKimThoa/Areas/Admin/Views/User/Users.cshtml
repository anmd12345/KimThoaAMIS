@using ManagementKimThoa.Constants
@using ManagementKimThoa.DTOs.User
@using ManagementKimThoa.DTOs.Role
@using ManagementKimThoa.DTOs.Branch
@model List<UserDto>
@{
    ViewData["Title"] = "Danh sách nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    List<RoleDto> roles = ViewBag.roles;
    List<BranchDto> branchs = ViewBag.branchs;

}

@section Styles{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}

<nav class="mb-3" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="#!">Bảng điều khiển</a></li>
        <li class="breadcrumb-item active">Nhân sự</li>
        <li class="breadcrumb-item active">Danh sách nhân sự</li>
    </ol>
</nav>
<div class="pb-6">
    <h2 class="mb-4">Danh sách nhân sự</h2>
    <div id="lealsTable" data-list='{"valueNames":["name","status", "email","phone","date-of-birth","gender","position", "branch", "is-insurance", "health-insurance-number", "id-card-number", "date-of-issue", "issue-author", "permanent-detail", "permanent-ward", "permanent-province", "birth-detail", "birth-ward", "birth-province", "card-number", "bank-name", "start-work-date"],"page":10,"pagination":true}'>



        <div class="row g-3 justify-content-between mb-4">
            <div class="col-auto">
                <div class="d-flex">
                    <div class="search-box me-2">
                        <form class="position-relative">
                            <input class="form-control search-input search" type="search" placeholder="Search by name" aria-label="Search" />
                            <span class="fas fa-search search-box-icon"></span>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <div class="d-md-flex justify-content-between">
                    <div>
                        <a href="@RouteConstant.CreateUser" class="btn btn-primary me-2 mb-2"><span class="fas fa-plus me-2"></span>Thêm nhân sự</a>
                        <button type="button"
                                class="btn btn-phoenix-primary me-2 mb-2"
                                data-bs-toggle="modal"
                                data-bs-target="#employeeFilterModal">

                            <i class="fas fa-filter me-2"></i>
                            <span>Bộ lọc<span id="filterCount" class="translate-middle badge rounded-pill bg-danger mx-2">0</span></span>
                        </button>
                        <button class="btn btn-link text-body px-0 mb-2 me-2"><span class="fa-solid fa-file-export fs-9 me-2"></span>Export Excel</button>

                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive scrollbar mx-n1 px-1">
            <table class="table fs-9 mb-0 leads-table border-top border-translucent">

                <thead>

                    <!-- Hàng 1 -->
                    <tr>
                        <th rowspan="2" style="width:18px;">
                            <div class="form-check mb-0 fs-8">
                                <input class="form-check-input"
                                       type="checkbox"
                                       data-bulk-select='{"body":"leal-tables-body"}' />
                            </div>
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            Nhân sự
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            Trạng thái
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            Email
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            SĐT
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-nowrap text-center">
                            Ngày sinh
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-nowrap text-center">
                            Giới tính
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-nowrap text-center">
                            Chức vụ
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-nowrap text-center">
                            Chi nhánh
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            BHXH
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            Mã BHXH
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            CCCD
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            Ngày cấp
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            Nơi cấp
                        </th>

                        <!-- Địa chỉ thường trú -->
                        <th colspan="3"
                            class="text-center border-end border-translucent text-nowrap text-center">
                            Địa chỉ thường trú
                        </th>

                        <!-- Khai sinh -->
                        <th colspan="3"
                            class="text-center border-end border-translucent text-center">
                            Nơi đăng ký khai sinh
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-center">
                            STK
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-nowrap text-center">
                            Ngân hàng
                        </th>

                        <th rowspan="2" class="border-end border-translucent text-nowrap text-center">
                            Ngày vào làm
                        </th>

                        <th rowspan="2"></th>
                    </tr>

                    <!-- Hàng 2 -->
                    <tr class="text-nowrap">

                        <th class="border-end border-translucent text-center">
                            Địa chỉ chi tiết
                        </th>

                        <th class="border-end border-translucent text-center">
                            Xã/Phường
                        </th>

                        <th class="border-end border-translucent text-center">
                            Tỉnh/Thành phố
                        </th>

                        <th class="border-end border-translucent text-center">
                            Địa chỉ chi tiết
                        </th>

                        <th class="border-end border-translucent text-center">
                            Xã/Phường
                        </th>

                        <th class="border-end border-translucent">
                            Tỉnh/Thành phố
                        </th>

                    </tr>

                </thead>

                <tbody class="list" id="leal-tables-body">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            var id = user.Id;

                            var userCode = user.UserCode;

                            var fullName = user.IDCard?.FullName;

                            var email = user.OtherInfor?.Email;

                            var phone = user.OtherInfor?.Phone;

                            var dateOfBirth = user.IDCard?.DateOfBirth;

                            var gender = user.IDCard?.Gender;

                            var positionName = user.Role?.RoleName;

                            var branchName = user.OtherInfor?.Branch?.BranchName;

                            var startWorkDate = string.IsNullOrEmpty(user.OtherInfor?.StartWorkDate) ? "" : DateTime.Parse(user?.OtherInfor?.StartWorkDate).ToString("dd/MM/yyyy");

                            var healthInsuranceNumber = user.HealthInsurance?.HealthInsuranceNumber;

                            var idCardNumber = user.IDCard?.IDCardNumber;

                            var dateOfIssue = user.IDCard?.DateOfIssue;

                            var issueAuthor = user.IDCard?.IssueAuthor;

                            var cardNumber = user.BankInfo?.CardNumber;

                            var status = user.IsStatus == 1 ? "Đang làm việc" : "Đã nghỉ việc";

                            var bankName = user.BankInfo?.BankName;

                            bool isInsurance = user.OtherInfor == null ? false : user.OtherInfor.IsInsurance;

                            var permanentProvince = user.IDCard?.Provinces;
                            var permanentWard = user.IDCard?.Ward;
                            var permanentDetail = user.IDCard?.AddressDescription;

                            var birthProvince = user.OtherInfor?.PlaceOfBirthRegistrationProvince;
                            var birthWard = user.OtherInfor?.PlaceOfBirthRegistrationWard;
                            var birthDetail = user.OtherInfor?.PlaceOfBirthRegistrationDetail;

                            var avatar = string.IsNullOrWhiteSpace(user?.OtherInfor?.AvatarUrl)
                                                    ? Url.Content("~/assets/img/defaults/avatars/default-avatar.png")
                                                    : $"/assets/uploads/avatars/{user?.OtherInfor?.AvatarUrl}";

                            var profileScan = user?.OtherInfor?.ProfileScanUrl;

                            var badgeClass = user?.IsStatus == 1
                                            ? "badge-phoenix-success"
                                            : "badge-phoenix-danger";

                            <tr class="hover-actions-trigger btn-reveal-trigger position-static employee-row" data-code="@userCode"
                                data-name="@fullName"
                                data-phone="@phone"
                                data-email="@email"
                                data-gender="@gender"
                                data-role="@positionName"
                                data-branch="@branchName"
                                data-status="@status"
                                data-insurance="@(isInsurance)"
                                data-province="@permanentProvince"
                                data-ward="@permanentWard"
                                data-birthprovince="@birthProvince"
                                data-birthward="@birthWard"
                                data-profile="@(profileScan)"
                                data-startdate="@(startWorkDate)">
                                <td class="fs-9 align-middle">
                                    <div class="form-check mb-0 fs-8">
                                        <input class="form-check-input"
                                               type="checkbox" />
                                    </div>
                                </td>

                                <td class="name align-middle white-space-nowrap ps-0 border-end border-translucent text-nowrap">
                                    <div class="d-flex align-items-center">

                                        <a href="@RouteConstant.ViewUser/@id">

                                            <div class="avatar avatar-xl me-3">
                                                <img class="rounded-circle"
                                                     src="@avatar"
                                                     alt="@(string.IsNullOrWhiteSpace(fullName) ? "Chưa cập nhật họ tên" : fullName)" />
                                            </div>
                                        </a>

                                        <div>

                                            <a class="fs-8 fw-bold"
                                               href="@($"{RouteConstant.ViewUser}/{id}")">
                                                @(string.IsNullOrWhiteSpace(fullName) ? "Chưa cập nhật họ tên" : fullName)
                                            </a>

                                            <div class="d-flex align-items-center">
                                                <p class="mb-0 text-body-highlight fw-semibold fs-9 me-2">
                                                    @user?.UserCode
                                                </p>
                                            </div>

                                        </div>

                                    </div>
                                </td>

                                <td class="status align-middle white-space-nowrap fw-semibold border-end border-translucent text-nowrap">
                                    <span class="badge badge-phoenix @badgeClass">
                                        @(user?.IsStatus == 1 ? "Đang làm việc" : "Đã nghỉ việc")
                                    </span>
                                </td>

                                <td class="email align-middle white-space-nowrap fw-semibold border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(email))
                                    {
                                        <a class="text-body-highlight"
                                           href="mailto:@email">
                                            @email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="phone align-middle white-space-nowrap fw-semibold border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(phone))
                                    {
                                        <a class="text-body-highlight"
                                           href="tel:@phone">
                                            @phone
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="date-of-birth align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(dateOfBirth))
                                    {
                                        @DateTime.Parse(dateOfBirth).ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="gender align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(gender))
                                    {
                                        @gender
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="position align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(positionName))
                                    {
                                        @if (positionName == RoleConstant.Manage)
                                        {
                                            <span>Quản lý</span>
                                        }
                                        else if (positionName == RoleConstant.Accountant)
                                        {
                                            <span>Kế toán</span>
                                        }
                                        else if (positionName == RoleConstant.Warehouse)
                                        {
                                            <span>Nhân viên kho</span>
                                        }
                                        else if (positionName == RoleConstant.SalesAgent)
                                        {

                                            <span>Nhân viên bán hàng</span>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="branch align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(branchName))
                                    {
                                        @branchName
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="is-insurance align-middle text-center border-end border-translucent text-nowrap">
                                    @if ((bool)isInsurance)
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-success">
                                            Tham gia
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa tham gia
                                        </span>
                                    }
                                </td>

                                <td class="health-insurance-number align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(healthInsuranceNumber))
                                    {
                                        @healthInsuranceNumber
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="id-card-number align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(idCardNumber))
                                    {
                                        @idCardNumber
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="date-of-issue align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(dateOfIssue))
                                    {
                                        @DateTime.Parse(dateOfIssue).ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="issue-author align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(issueAuthor))
                                    {
                                        @issueAuthor
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="permanent-detail align-middle border-end border-translucent text-nowrap">
                                    @permanentDetail
                                </td>

                                <td class="permanent-ward align-middle border-end border-translucent text-nowrap">
                                    @permanentWard
                                </td>

                                <td class="permanent-province align-middle border-end border-translucent text-nowrap">
                                    @permanentProvince
                                </td>

                                <td class="birth-detail align-middle border-end border-translucent text-nowrap">
                                    @birthDetail
                                </td>

                                <td class="birth-ward align-middle border-end border-translucent text-nowrap">
                                    @birthWard
                                </td>

                                <td class="birth-province align-middle border-end border-translucent text-nowrap">
                                    @birthProvince
                                </td>

                                <td class="card-number align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(cardNumber))
                                    {
                                        @cardNumber
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="bank-name align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(bankName))
                                    {
                                        @bankName
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="start-work-date align-middle border-end border-translucent text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(startWorkDate))
                                    {
                                        @startWorkDate
                                    }
                                    else
                                    {
                                        <span class="badge badge-phoenix badge-phoenix-warning">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <td class="align-middle white-space-nowrap text-end pe-0 ps-4 text-nowrap">

                                    <div class="btn-reveal-trigger position-static">

                                        <button class="btn btn-sm dropdown-toggle dropdown-caret-none transition-none btn-reveal fs-10"
                                                type="button"
                                                data-bs-toggle="dropdown">

                                            <span class="fas fa-ellipsis-h fs-10"></span>
                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end py-2">

                                            <a class="dropdown-item"
                                               href="@RouteConstant.ViewUser/@id">

                                                Chi tiết
                                            </a>

                                            <a class="dropdown-item"
                                               href="@RouteConstant.EditUser/@id">

                                                Chỉnh sửa
                                            </a>

                                            <div class="dropdown-divider"></div>

                                            <a class="dropdown-item text-danger"
                                               asp-action="Delete"
                                               asp-route-id="@id">

                                                Xóa nhân sự
                                            </a>

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="17" class="text-center py-5">
                                Chưa có dữ liệu nhân sự
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>
        <div class="row align-items-center justify-content-end py-4 pe-0 fs-9">
            <div class="col-auto d-flex">
                <p class="mb-0 d-none d-sm-block me-3 fw-semibold text-body" data-list-info="data-list-info"></p><a class="fw-semibold" href="#!" data-list-view="*">View all<span class="fas fa-angle-right ms-1" data-fa-transform="down-1"></span></a><a class="fw-semibold d-none" href="#!" data-list-view="less">View Less<span class="fas fa-angle-right ms-1" data-fa-transform="down-1"></span></a>
            </div>
            <div class="col-auto d-flex">
                <button class="page-link" data-list-pagination="prev"><span class="fas fa-chevron-left"></span></button>
                <ul class="mb-0 pagination"></ul><button class="page-link pe-0" data-list-pagination="next"><span class="fas fa-chevron-right"></span></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="employeeFilterModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Bộ lọc nhân sự
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="row g-3">

                    <!-- Tìm kiếm -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Từ khóa
                        </label>

                        <input id="filterKeyword"
                               class="form-control"
                               placeholder="Mã NV, họ tên, CCCD, SĐT..." />
                    </div>

                    <!-- Trạng thái -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select id="filterStatus"
                                class="form-select">

                            <option value="">
                                Tất cả
                            </option>

                            <option value="Đang làm việc">
                                Đang làm việc
                            </option>

                            <option value="Đã nghỉ việc">
                                Đã nghỉ việc
                            </option>

                        </select>
                    </div>

                    <!-- Giới tính -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Giới tính
                        </label>

                        <select id="filterGender"
                                class="form-select">

                            <option value="">
                                Tất cả
                            </option>

                            <option value="Nam">
                                Nam
                            </option>

                            <option value="Nữ">
                                Nữ
                            </option>

                            <option value="Khác">
                                Khác
                            </option>

                        </select>
                    </div>

                    <!-- Vai trò -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Vai trò
                        </label>

                        <select id="filterRole"
                                class="form-select">

                            <option value="">
                                Tất cả
                            </option>

                            @foreach (var role in roles)
                            {
                                <option value="@role.RoleName">
                                    @role.RoleName
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Chi nhánh -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Chi nhánh
                        </label>

                        <select id="filterBranch"
                                class="form-select">

                            <option value="">
                                Tất cả
                            </option>

                            @foreach (var branch in branchs)
                            {
                                <option value="@branch.BranchName">
                                    @branch.BranchName
                                </option>
                            }

                        </select>
                    </div>

                    <!-- BHXH -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Bảo hiểm xã hội
                        </label>

                        <select id="filterInsurance"
                                class="form-select">

                            <option value="">
                                Tất cả
                            </option>

                            <option value="True">
                                Có
                            </option>

                            <option value="False">
                                Không
                            </option>

                        </select>
                    </div>

                    <!-- Địa chỉ thường trú -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Tỉnh thường trú
                        </label>

                        <select id="filterProvince"
                                class="form-select select2">
                            <option value="">
                                Tất cả
                            </option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Xã/Phường thường trú
                        </label>

                        <select id="filterWard"
                                class="form-select select2">
                            <option value="">
                                Tất cả
                            </option>
                        </select>
                    </div>

                    <!-- Nơi đăng ký khai sinh -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Tỉnh khai sinh
                        </label>

                        <select id="filterBirthProvince"
                                class="form-select select2">
                            <option value="">
                                Tất cả
                            </option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Xã/Phường khai sinh
                        </label>

                        <select id="filterBirthWard"
                                class="form-select select2">
                            <option value="">
                                Tất cả
                            </option>
                        </select>
                    </div>

                    <!-- Hồ sơ scan -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Hồ sơ scan
                        </label>

                        <select id="filterProfile"
                                class="form-select">

                            <option value="">
                                Tất cả
                            </option>

                            <option value="true">
                                Đã có
                            </option>

                            <option value="false">
                                Chưa có
                            </option>

                        </select>
                    </div>

                    <!-- Ngày vào làm -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Làm từ ngày
                        </label>

                        <input type="date"
                               id="filterStartFrom"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Đến ngày
                        </label>

                        <input type="date"
                               id="filterStartTo"
                               class="form-control" />
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="btnResetFilter"
                        class="btn btn-phoenix-secondary">
                    Xóa bộ lọc
                </button>

                <button type="button"
                        id="btnApplyFilter"
                        class="btn btn-primary">
                    Áp dụng
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts{


    <script src="~/assets/js/province.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>const provinces = getProvinces();

        $("#btnApplyFilter").on("click", function () {

            filterEmployees();

            bootstrap.Modal
                .getInstance(
                    document.getElementById("employeeFilterModal")
                )
                ?.hide();
        });

        $("#btnResetFilter").on("click", function () {

            $("#employeeFilterModal")
                .find("input")
                .val("");

            $("#employeeFilterModal")
                .find("select")
                .val("")
                .trigger("change");

            filterEmployees();
        });

        function filterEmployees() {

            const keyword = ($("#filterKeyword").val() || "")
                .toString()
                .trim()
                .toLowerCase();

            const status = $("#filterStatus").val();
            const gender = $("#filterGender").val();
            const role = $("#filterRole").val();
            const branch = $("#filterBranch").val();

            const insurance = $("#filterInsurance").val();

            const province = $("#filterProvince").val();
            const ward = $("#filterWard").val();

            const birthProvince = $("#filterBirthProvince").val();
            const birthWard = $("#filterBirthWard").val();

            const hasProfile = $("#filterProfile").val();

            const startFrom = $("#filterStartFrom").val();
            const startTo = $("#filterStartTo").val();

            let visibleCount = 0;

            $(".employee-row").each(function () {

                const row = $(this);

                const employeeCode = (row.data("code") || "")
                    .toString()
                    .toLowerCase();

                const fullName = (row.data("name") || "")
                    .toString()
                    .toLowerCase();

                const phone = (row.data("phone") || "")
                    .toString()
                    .toLowerCase();

                const email = (row.data("email") || "")
                    .toString()
                    .toLowerCase();

                const rowStatus = (row.data("status") || "").toString();
                const rowGender = (row.data("gender") || "").toString();
                const rowRole = (row.data("role") || "").toString();
                const rowBranch = (row.data("branch") || "").toString();

                const rowInsurance = (row.data("insurance") || "").toString();

                const rowProvince = (row.data("province") || "").toString();
                const rowWard = (row.data("ward") || "").toString();

                const rowBirthProvince = (row.data("birthprovince") || "").toString();
                const rowBirthWard = (row.data("birthward") || "").toString();

                const rowProfile = (row.data("profile") || "").toString();

                const rowStartDate = (row.data("startdate") || "").toString();

                let isMatch = true;

                // Keyword
                if (keyword) {

                    const found =
                        employeeCode.includes(keyword) ||
                        fullName.includes(keyword) ||
                        phone.includes(keyword) ||
                        email.includes(keyword);

                    if (!found) {
                        isMatch = false;
                    }
                }

                // Trạng thái
                if (isMatch && status && rowStatus !== status) {
                    isMatch = false;
                }

                // Giới tính
                if (isMatch && gender && rowGender !== gender) {
                    isMatch = false;
                }

                // Vai trò
                if (isMatch && role && rowRole !== role) {
                    isMatch = false;
                }

                // Chi nhánh
                if (isMatch && branch && rowBranch !== branch) {
                    isMatch = false;
                }

                // BHXH
                if (isMatch && insurance && rowInsurance !== insurance) {
                    isMatch = false;
                }

                // Tỉnh thường trú
                if (isMatch && province && rowProvince !== province) {
                    isMatch = false;
                }

                // Xã thường trú
                if (isMatch && ward && rowWard !== ward) {
                    isMatch = false;
                }

                // Tỉnh khai sinh
                if (isMatch && birthProvince && rowBirthProvince !== birthProvince) {
                    isMatch = false;
                }

                // Xã khai sinh
                if (isMatch && birthWard && rowBirthWard !== birthWard) {
                    isMatch = false;
                }

                // Hồ sơ scan
                if (isMatch && hasProfile && rowProfile !== hasProfile) {
                    isMatch = false;
                }

                // Từ ngày
                if (isMatch && startFrom && rowStartDate) {

                    const employeeDate = new Date(rowStartDate);
                    const fromDate = new Date(startFrom);

                    if (employeeDate < fromDate) {
                        isMatch = false;
                    }
                }

                // Đến ngày
                if (isMatch && startTo && rowStartDate) {

                    const employeeDate = new Date(rowStartDate);
                    const toDate = new Date(startTo);

                    toDate.setHours(23, 59, 59, 999);

                    if (employeeDate > toDate) {
                        isMatch = false;
                    }
                }

                row.toggle(isMatch);

                if (isMatch) {
                    visibleCount++;
                }
            });

            $("#employeeCount").text(visibleCount);

            updateFilterCount();
        }

        function updateFilterCount() {

            let count = 0;

            $("#employeeFilterModal")
                .find("input, select")
                .each(function () {

                    const value = $(this).val();

                    if (value && value !== "") {
                        count++;
                    }
                });

            $("#filterCount").html(count);
        }

        function initProvinceFilter() {

            const provinceSelects = [
                "#filterProvince",
                "#filterBirthProvince"
            ];

            provinceSelects.forEach(selector => {

                const select = $(selector);

                select.empty();
                select.append('<option value="">Tất cả</option>');

                provinces.forEach(province => {

                    select.append(`
                <option
                    value="${province.name}"
                    data-code="${province.code}">
                    ${province.name}
                </option>
            `);
                });

                select.trigger("change.select2");
            });
        }

        function loadWardFilter(provinceCode, wardSelector) {

            const wardSelect = $(wardSelector);

            wardSelect.empty();
            wardSelect.append('<option value="">Tất cả</option>');

            if (!provinceCode) {

                wardSelect.trigger("change.select2");
                return;
            }

            const province = provinces.find(
                p => p.code == provinceCode
            );

            if (!province || !province.wards) {

                wardSelect.trigger("change.select2");
                return;
            }

            province.wards.forEach(ward => {

                wardSelect.append(`
            <option value="${ward.name}">
                ${ward.name}
            </option>
        `);

            });

            wardSelect.trigger("change.select2");
        }

        $(document).on(
            "change",
            "#filterProvince",
            function () {

                const provinceCode = $(this)
                    .find(":selected")
                    .data("code");

                loadWardFilter(
                    provinceCode,
                    "#filterWard"
                );
            }
        );

        $(document).on(
            "change",
            "#filterBirthProvince",
            function () {

                const provinceCode = $(this)
                    .find(":selected")
                    .data("code");

                loadWardFilter(
                    provinceCode,
                    "#filterBirthWard"
                );
            }
        );

        document.addEventListener("DOMContentLoaded", function () {

            initProvinceFilter();

            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

        });</script>



}