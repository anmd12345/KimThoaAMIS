@using ManagementKimThoa.Constants
@using ManagementKimThoa.DTOs.User
@using System.Text.Json;
@{
    UserSession currentUser = ViewBag.currentUser;
}
<!DOCTYPE html>
<html lang="en-US" dir="ltr" data-navigation-type="default" data-navbar-horizontal-shape="default">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - Hệ thống sữa Kim Thoa</title>

    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/img/defaults/icons/favicon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/img/defaults/icons/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/img/defaults/icons/favicon.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/defaults/icons/favicon.png">
    <meta name="msapplication-TileImage" content="~/assets/img/defaults/icons/favicon.png">
    <meta name="theme-color" content="#ffffff">
    <script src="~/vendors/simplebar/simplebar.min.js"></script>
    <script src="~/assets/js/config.js"></script>

    <link href="~/vendors/nouislider/nouislider.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="~/vendors/simplebar/simplebar.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">
    <link href="~/assets/css/theme-rtl.min.css" type="text/css" rel="stylesheet" id="style-rtl">
    <link href="~/assets/css/theme.min.css" type="text/css" rel="stylesheet" id="style-default">
    <link href="~/assets/css/user-rtl.min.css" type="text/css" rel="stylesheet" id="user-style-rtl">
    <link href="~/assets/css/user.min.css" type="text/css" rel="stylesheet" id="user-style-default">
    <script>var phoenixIsRTL = window.config.config.phoenixIsRTL;
        if (phoenixIsRTL) {
            var linkDefault = document.getElementById('style-default');
            var userLinkDefault = document.getElementById('user-style-default');
            linkDefault.setAttribute('disabled', true);
            userLinkDefault.setAttribute('disabled', true);
            document.querySelector('html').setAttribute('dir', 'rtl');
        } else {
            var linkRTL = document.getElementById('style-rtl');
            var userLinkRTL = document.getElementById('user-style-rtl');
            linkRTL.setAttribute('disabled', true);
            userLinkRTL.setAttribute('disabled', true);
        }</script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="" style="background-color: white">
    <main class="main" id="top">
        <div class="container-medium d-flex align-items-center justify-content-between mt-2">
            <a class="btn btn-link p-0 text-body" href="@RouteConstant.Login">
                @if (currentUser == null)
                {
                    <span class="fa-solid fa-arrow-right-to-bracket me-2" data-fa-transform="down-1"></span>
                    <span>Đăng nhập</span>
                }
            </a>
            @if (currentUser != null && (currentUser.RoleName == RoleConstant.Admin || currentUser.RoleName == RoleConstant.Manage))
            {
                <div class="dropdown">
                    <button class="btn btn-sm p-0 d-md-none fs-8" type="button" data-bs-toggle="dropdown" data-boundary="window" aria-haspopup="true" aria-expanded="false" data-bs-reference="parent"><span class="fas fa-ellipsis-h"></span></button>
                    <ul class="dropdown-menu dropdown-menu-end" style="z-index: 9999">
                        <li>
                            <a class="dropdown-item" href="@RouteConstant.Dashboard">Bảng điều khiển</a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@RouteConstant.Logout">Đăng xuất</a>
                        </li>

                    </ul>
                </div>
                <ul class="d-none d-md-flex gap-5 list-unstyled mb-0">
                    <li>
                        <a class="lh-1 text-body-tertiary fw-semibold fs-9" href="@RouteConstant.Dashboard">Bảng điều khiển</a>
                    </li>
                    <li>
                        <a class="lh-1 text-body-tertiary fw-semibold fs-9" href="@RouteConstant.Logout">Đăng xuất</a>
                    </li>
                </ul>
            }

        </div>
        <div class="bg-body-emphasis sticky-top shadow-sm" data-navbar-shadow-on-scroll="data-navbar-shadow-on-scroll">
            <nav class="navbar navbar-landing container-medium py-3 flex-wrap align-items-center">

                <a class="navbar-brand flex-1 flex-lg-grow-0 me-auto" href="/">
                    <div class="d-flex align-items-center">
                        <img src="~/assets/img/defaults/logos/logo.png" alt="Sữa Kim Thoa" width="130" />
                    </div>
                </a>

                <div class="d-flex align-items-center gap-2 order-lg-2">
                    <div class="theme-control-toggle fa-icon-wait">
                        <input class="form-check-input ms-0 theme-control-toggle-input" type="checkbox" data-theme-control="phoenixTheme" value="dark" id="themeControlToggleSm" />
                        <label class="mb-0 theme-control-toggle-label theme-control-toggle-light" for="themeControlToggleSm" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="Đổi giao diện" style="height:32px;width:32px;"><span class="icon" data-feather="moon"></span></label>
                        <label class="mb-0 theme-control-toggle-label theme-control-toggle-dark" for="themeControlToggleSm" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="Đổi giao diện" style="height:32px;width:32px;"><span class="icon" data-feather="sun"></span></label>
                    </div>
                </div>

                <div class="flex-grow-1 mx-lg-4 w-100 w-lg-auto mt-3 mt-lg-0 order-lg-1">
                    <div class="input-group">
                        <span class="input-group-text bg-body-secondary border-end-0">
                            <i class="fa-solid fa-barcode text-body-tertiary"></i>
                        </span>
                        <input type="text" class="form-control bg-body-secondary border-start-0 ps-2 shadow-none" placeholder="Quét mã vạch hoặc nhập mã SP..." autofocus>
                        <button class="btn btn-primary px-3 px-md-4 fw-bold" type="button">Tìm kiếm</button>
                    </div>
                </div>

            </nav>
        </div>

        <div class="pt-5 pb-9">
            @RenderBody()
        </div>
    </main>

    <script src="~/vendors/popper/popper.min.js"></script>
    <script src="~/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/vendors/anchorjs/anchor.min.js"></script>
    <script src="~/vendors/is/is.min.js"></script>
    <script src="~/vendors/fontawesome/all.min.js"></script>
    <script src="~/vendors/lodash/lodash.min.js"></script>
    <script src="~/vendors/list.js/list.min.js"></script>
    <script src="~/vendors/feather-icons/feather.min.js"></script>
    <script src="~/vendors/dayjs/dayjs.min.js"></script>
    <script src="~/assets/js/phoenix.js"></script>
    <script src="~/vendors/nouislider/nouislider.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>