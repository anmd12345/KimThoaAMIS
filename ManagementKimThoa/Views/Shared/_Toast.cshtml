<div class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index:9999;">

    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center text-bg-success border-0 toast-item"
             role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Success"]
                </div>

                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center text-bg-danger border-0 toast-item"
             role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Error"]
                </div>

                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>
            </div>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="toast align-items-center text-bg-warning border-0 toast-item"
             role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Warning"]
                </div>

                <button type="button"
                        class="btn-close me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>
            </div>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="toast align-items-center text-bg-info border-0 toast-item"
             role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Info"]
                </div>

                <button type="button"
                        class="btn-close me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>
            </div>
        </div>
    }
</div>


<script>function showToast(type, message) {

        const container =
            document.querySelector(".toast-container");

        const bgMap = {
            success: "text-bg-success",
            error: "text-bg-danger",
            warning: "text-bg-warning",
            info: "text-bg-info"
        };

        const closeClass =
            type === "success" || type === "error"
                ? "btn-close-white"
                : "";

        const toastHtml = `
            <div class="toast align-items-center ${bgMap[type]} border-0 toast-item"
                 role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>

                    <button type="button"
                            class="btn-close ${closeClass} me-2 m-auto"
                            data-bs-dismiss="toast">
                    </button>
                </div>
            </div>
        `;

        container.insertAdjacentHTML(
            "beforeend",
            toastHtml
        );

        const toastElement =
            container.lastElementChild;

        const toast =
            new bootstrap.Toast(
                toastElement,
                {
                    delay: 2000
                });

        toast.show();

        toastElement.addEventListener(
            "hidden.bs.toast",
            function () {
                toastElement.remove();
            });
    }</script>