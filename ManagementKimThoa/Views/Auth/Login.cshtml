
@model ManagementKimThoa.ViewModels.Account.LoginViewModel
@using ManagementKimThoa.Constants

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en-US" dir="ltr" data-navigation-type="default" data-navbar-horizontal-shape="default">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- ===============================================-->
    <!--    Document Title-->
    <!-- ===============================================-->
    <title>Login</title>

    <!-- ===============================================-->
    <!--    Favicons-->
    <!-- ===============================================-->
    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/img/defaults/icons/favicon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/img/defaults/icons/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/img/defaults/icons/favicon.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/defaults/icons/favicon.png">
    <meta name="msapplication-TileImage" content="~/assets/img/defaults/icons/favicon.png">
    <meta name="theme-color" content="#ffffff">
    <script src="~/vendors/simplebar/simplebar.min.js"></script>
    <script src="~/assets/js/config.js"></script>

    <!-- ===============================================-->
    <!--    Stylesheets-->
    <!-- ===============================================-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="~/vendors/simplebar/simplebar.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">
    <link href="~/assets/css/theme-rtl.min.css" type="text/css" rel="stylesheet" id="style-rtl">
    <link href="~/assets/css/theme.min.css" type="text/css" rel="stylesheet" id="style-default">
    <link href="~/assets/css/user-rtl.min.css" type="text/css" rel="stylesheet" id="user-style-rtl">
    <link href="~/assets/css/user.min.css" type="text/css" rel="stylesheet" id="user-style-default">
    <script>var phoenixIsRTL = window.config.config.phoenixIsRTL;
        if (phoenixIsRTL) {
            var linkDefault = document.getElementById('style-default');
            var userLinkDefault = document.getElementById('user-style-default');
            linkDefault.setAttribute('disabled', true);
            userLinkDefault.setAttribute('disabled', true);
            document.querySelector('html').setAttribute('dir', 'rtl');
        } else {
            var linkRTL = document.getElementById('style-rtl');
            var userLinkRTL = document.getElementById('user-style-rtl');
            linkRTL.setAttribute('disabled', true);
            userLinkRTL.setAttribute('disabled', true);
        }</script>
</head>

<body>
    <!-- ===============================================-->
    <!--    Main Content-->
    <!-- ===============================================-->
    <main class="main" id="top">
        <div class="container-fluid bg-body-tertiary dark__bg-gray-1200">
            <div class="bg-holder bg-auth-card-overlay" style="background-image:url(/assets/img/bgs/37.png);"></div>
            <!--/.bg-holder-->
            <div class="row flex-center position-relative min-vh-100 g-0 py-5">
                <div class="col-11 col-sm-10 col-xl-8">
                    <div class="card border border-translucent auth-card">
                        <div class="card-body pe-md-0">
                            <div class="row align-items-center gx-0 gy-7">
                                <div class="col-auto bg-body-highlight dark__bg-gray-1100 rounded-3 position-relative overflow-hidden auth-title-box">
                                    <div class="bg-holder" style="background-image:url(/assets/img/bgs/38.png);"></div>
                                    <!--/.bg-holder-->
                                    <div class="position-relative px-4 px-lg-7 pt-7 pb-7 pb-sm-5 text-center text-md-start pb-lg-7 pb-md-7">
                                        <h3 class="mb-3 text-body-emphasis fs-7">KimThoa AMIS</h3>
                                        <p class="text-body-tertiary">Give yourself some hassle-free development process with the uniqueness!</p>
                                        <ul class="list-unstyled mb-0 w-max-content w-md-auto">
                                            <li class="d-flex align-items-center"><span class="uil uil-check-circle text-success me-2"></span><span class="text-body-tertiary fw-semibold">Fast</span></li>
                                            <li class="d-flex align-items-center"><span class="uil uil-check-circle text-success me-2"></span><span class="text-body-tertiary fw-semibold">Simple</span></li>
                                            <li class="d-flex align-items-center"><span class="uil uil-check-circle text-success me-2"></span><span class="text-body-tertiary fw-semibold">Responsive</span></li>
                                        </ul>
                                    </div>
                                    <div class="position-relative z-n1 mb-6 d-none d-md-block text-center mt-md-15"><img class="auth-title-box-img d-dark-none" src="~/assets/img/spot-illustrations/auth.png" alt="" /><img class="auth-title-box-img d-light-none" src="~/assets/img/spot-illustrations/auth-dark.png" alt="" /></div>
                                </div>
                                <div class="col mx-auto">
                                    <div class="auth-form-box">
                                        <div class="text-center mb-7">
                                            <a class="d-flex flex-center text-decoration-none mb-4" href="/">
                                                <div class="d-flex align-items-center fw-bolder fs-3 d-inline-block"><img src="~/assets/img/defaults/logos/logo.png" alt="phoenix" width="200" /></div>
                                            </a>
                                            <h3 class="text-body-highlight">Sign In</h3>
                                            <p class="text-body-tertiary">Get access to your account</p>
                                        </div>

                                        <form id="loginForm"
                                              method="post"
                                              action="@RouteConstant.Login">

                                            @Html.AntiForgeryToken()

                                            <div class="mb-3 text-start">
                                                <label class="form-label">Username</label>

                                                <div class="form-icon-container">
                                                    <input id="username"
                                                           name="Username"
                                                           value="@Model?.Username"
                                                           class="form-control form-icon-input"
                                                           type="text"
                                                           placeholder="Username" />

                                                    <span class="fas fa-user text-body fs-9 form-icon"></span>
                                                </div>
                                            </div>

                                            <div class="mb-3 text-start">
                                                <label class="form-label">Password</label>

                                                <div class="form-icon-container" data-password="data-password">

                                                    <input id="password"
                                                           name="Password"
                                                           class="form-control form-icon-input pe-6"
                                                           type="password"
                                                           placeholder="Password" />

                                                    <span class="fas fa-key text-body fs-9 form-icon"></span>

                                                    <button type="button"
                                                            class="btn px-3 py-0 h-100 position-absolute top-0 end-0 fs-7 text-body-tertiary"
                                                            data-password-toggle="data-password-toggle">
                                                        <span class="uil uil-eye show"></span>
                                                        <span class="uil uil-eye-slash hide"></span>
                                                    </button>

                                                </div>
                                            </div>

                                            <div class="row flex-between-center mb-7">
                                                <div class="col-auto">
                                                    <div class="form-check mb-0">
                                                        <input name="RememberMe"
                                                               class="form-check-input"
                                                               id="rememberMe"
                                                               type="checkbox" />

                                                        <label class="form-check-label mb-0" for="rememberMe">
                                                            Remember me
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <button type="submit"
                                                    class="btn btn-primary w-100 mb-3">
                                                Sign In
                                            </button>

                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    @await Html.PartialAsync("_Toast")

    <script src="~/vendors/popper/popper.min.js"></script>
    <script src="~/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/vendors/anchorjs/anchor.min.js"></script>
    <script src="~/vendors/is/is.min.js"></script>
    <script src="~/vendors/fontawesome/all.min.js"></script>
    <script src="~/vendors/lodash/lodash.min.js"></script>
    <script src="~/vendors/list.js/list.min.js"></script>
    <script src="~/vendors/feather-icons/feather.min.js"></script>
    <script src="~/vendors/dayjs/dayjs.min.js"></script>
    <script src="~/assets/js/phoenix.js"></script>

    <script>document.addEventListener("DOMContentLoaded", function () {
            const toastElList = document.querySelectorAll('.toast-item');
            toastElList.forEach(function (item) {
                const toast = new bootstrap.Toast(item, { delay: 3000 });
                toast.show();
            });
        });</script>

    <script>
document.addEventListener("DOMContentLoaded", function () {

    const form = document.getElementById("loginForm");
    const usernameInput =
        document.getElementById("username");

    const passwordInput =
        document.getElementById("password");

    const rememberCheckbox =
        document.getElementById("rememberMe");

    const token =
        document.querySelector(
            'input[name="__RequestVerificationToken"]'
        ).value;

    // ===== AUTO LOGIN =====
    const remembered =
        sessionStorage.getItem("remember_login");

    if (remembered) {
        try {

            const data =
                JSON.parse(remembered);

            usernameInput.value =
                data.username || "";

            passwordInput.value =
                data.password || "";

            rememberCheckbox.checked = true;

            if (data.username &&
                data.password) {

                login(
                    data.username,
                    data.password,
                    true
                );
            }
        }
        catch {
            sessionStorage.removeItem(
                "remember_login"
            );
        }
    }

    // ===== SUBMIT FORM =====
    form.addEventListener(
        "submit",
        async function (e) {

        e.preventDefault();

        await login(
            usernameInput.value,
            passwordInput.value,
            rememberCheckbox.checked
        );
    });

    async function login(
        username,
        password,
        rememberMe) {

        try {

            const response = await fetch(
                "@RouteConstant.Login",
                {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/json",
                        "RequestVerificationToken":
                            token
                    },
                    body: JSON.stringify({
                        username,
                        password
                    })
                });

            const result =
                await response.json();

            if (!result.success) {

                sessionStorage.removeItem(
                    "remember_login"
                );

                showToast(
                    "error",
                    result.message
                );
                return;
            }

            // save only success
            if (rememberMe) {

                sessionStorage.setItem(
                    "remember_login",
                    JSON.stringify({
                        username,
                        password
                    })
                );
            }
            else {

                sessionStorage.removeItem(
                    "remember_login"
                );
            }

            showToast(
                "success",
                result.message
            );

            setTimeout(() => {
                window.location.href =
                    result.redirectUrl;
            }, 1200);
        }
        catch {

            showToast(
                "error",
                'Có lỗi xảy ra!'
            );
        }
    }
});
    </script>
</body>

</html>